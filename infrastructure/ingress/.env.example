# Names only. Copy to a chmod 600 file outside git (never commit values).
# Preferred public HTTPS origin for this Companion install (no trailing slash).
COMPANION_PUBLIC_BASE_URL=https://companion.example.com

# Named Cloudflare Tunnel token file (mode 600). Prefer a file over inline plist tokens.
CLOUDFLARED_TUNNEL_TOKEN_FILE=/Users/REPLACE/.cloudflared/companion.token

# Local Next listen target the tunnel should forward to (pnpm start default).
COMPANION_INGRESS_SERVICE=http://127.0.0.1:3000

# Optional: Cloudflare hostname(s) routed to this install (dashboard or config).
# COMPANION_INGRESS_HOSTNAME=companion.example.com
