{
  "$schema": "https://react.doctor/schema/config.json",
  "rules": {
    "react-doctor/only-export-components": "off",
    "react-doctor/async-await-in-loop": "off",
    "react-doctor/js-combine-iterations": "off",
    "react-doctor/js-cache-property-access": "off",
    "react-doctor/js-set-map-lookups": "off",
    "react-doctor/js-flatmap-filter": "off",
    "react-doctor/react-compiler-no-manual-memoization": "off",
    "react-doctor/no-giant-component": "off",
    "react-doctor/prefer-useReducer": "off",
    "react-doctor/server-hoist-static-io": "off",
    "react-doctor/no-adjust-state-on-prop-change": "off",
    "react-doctor/no-usememo-simple-expression": "off",
    "react-doctor/nextjs-no-img-element": "off",
    "react-doctor/rerender-state-only-in-handlers": "off",
    "react-doctor/server-sequential-independent-await": "off",
    "react-doctor/no-high-complexity-react-function": "off",
    "react-doctor/agent-tool-capability-risk": "off",
    "react-doctor/clickjacking-redirect-risk": "off",
    "react-doctor/insecure-crypto-risk": "off",
    "react-doctor/duplicate-jsx-subtree": "off",
    "react-doctor/no-static-element-interactions": "off",
    "react-doctor/require-pnpm-hardening": "off",
    "react-doctor/no-locale-format-in-render": "off"
  },
  "ignore": {
    "files": [
      "agent/subagents/browser-agent/tools/**",
      "evals/**",
      "tools/oxlint/**",
      "web/components/ai-elements/**",
      "web/components/ui/**"
    ]
  }
}
