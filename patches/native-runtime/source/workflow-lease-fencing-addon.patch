diff --git a/packages/world-postgres/src/worker-lease.ts b/packages/world-postgres/src/worker-lease.ts
new file mode 100644
index 0000000..1d1cb78
--- /dev/null
+++ b/packages/world-postgres/src/worker-lease.ts
@@ -0,0 +1,310 @@
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { createRequire } from 'node:module';
+import { WorkflowWorldError } from '@workflow/errors';
+import type { Pool, PoolClient } from 'pg';
+
+export type WorkerLeaseTiming = {
+  /** How long a lease remains valid without renewal (PostgreSQL clock). */
+  leaseMs: number;
+  /** How often a healthy worker renews its lease and Graphile lock timestamps. */
+  heartbeatMs: number;
+  /** How often the world scans for expired leases to reclaim. */
+  reclaimIntervalMs: number;
+};
+
+export const DEFAULT_WORKER_LEASE_TIMING: WorkerLeaseTiming = {
+  leaseMs: 30_000,
+  heartbeatMs: 10_000,
+  reclaimIntervalMs: 5_000,
+};
+
+export type WorkerLeaseIdentity = {
+  readonly workerId: string;
+  readonly generation: number;
+};
+
+const leaseContext = new AsyncLocalStorage<WorkerLeaseIdentity>();
+
+/** Headers bind an HTTP execution to a Graphile worker generation. */
+export const WORKER_LEASE_HEADERS = {
+  workerId: 'x-workflow-worker-id',
+  generation: 'x-workflow-worker-generation',
+  jobId: 'x-workflow-job-id',
+} as const;
+
+export function getWorkerLeaseContext(): WorkerLeaseIdentity | undefined {
+  return leaseContext.getStore();
+}
+
+export function runWithWorkerLease<T>(
+  identity: WorkerLeaseIdentity,
+  fn: () => T
+): T {
+  return leaseContext.run(identity, fn);
+}
+
+export function resolveWorkerLeaseTiming(
+  partial?: Partial<WorkerLeaseTiming>
+): WorkerLeaseTiming {
+  const timing = {
+    leaseMs: partial?.leaseMs ?? DEFAULT_WORKER_LEASE_TIMING.leaseMs,
+    heartbeatMs: partial?.heartbeatMs ?? DEFAULT_WORKER_LEASE_TIMING.heartbeatMs,
+    reclaimIntervalMs:
+      partial?.reclaimIntervalMs ??
+      DEFAULT_WORKER_LEASE_TIMING.reclaimIntervalMs,
+  };
+  if (
+    !(
+      Number.isFinite(timing.leaseMs) &&
+      timing.leaseMs >= 1_000 &&
+      Number.isFinite(timing.heartbeatMs) &&
+      timing.heartbeatMs >= 100 &&
+      timing.heartbeatMs < timing.leaseMs &&
+      Number.isFinite(timing.reclaimIntervalMs) &&
+      timing.reclaimIntervalMs >= 100
+    )
+  ) {
+    throw new TypeError(
+      'Worker lease timing requires leaseMs >= 1000, 100 <= heartbeatMs < leaseMs, and reclaimIntervalMs >= 100.'
+    );
+  }
+  return timing;
+}
+
+type Queryable = Pick<Pool, 'query'> | Pick<PoolClient, 'query'>;
+
+export class WorkerLeaseFencedError extends WorkflowWorldError {
+  constructor(message = 'Worker lease generation is no longer valid.') {
+    super(message, { status: 409 });
+    this.name = 'WorkerLeaseFencedError';
+  }
+}
+
+/**
+ * Register a new worker generation before Graphile can claim jobs.
+ * Retired worker IDs are never reused.
+ */
+export async function registerWorkerLease(
+  db: Queryable,
+  workerId: string,
+  leaseMs: number
+): Promise<WorkerLeaseIdentity> {
+  const existing = await db.query<{
+    generation: string;
+    retired: boolean;
+  }>(
+    `SELECT generation::text, retired FROM workflow.worker_leases WHERE worker_id = $1`,
+    [workerId]
+  );
+  if (existing.rows[0]?.retired) {
+    throw new WorkerLeaseFencedError(
+      `Worker identity ${workerId} was retired and cannot be reused.`
+    );
+  }
+  if (existing.rows[0]) {
+    const renewed = await renewWorkerLease(
+      db,
+      { workerId, generation: Number(existing.rows[0].generation) },
+      leaseMs
+    );
+    if (!renewed) {
+      throw new WorkerLeaseFencedError(
+        `Worker identity ${workerId} could not renew its existing lease.`
+      );
+    }
+    return { workerId, generation: Number(existing.rows[0].generation) };
+  }
+
+  const inserted = await db.query<{ generation: string }>(
+    `INSERT INTO workflow.worker_leases (worker_id, generation, lease_until, retired)
+     VALUES ($1, 1, now() + ($2::text || ' milliseconds')::interval, false)
+     RETURNING generation::text`,
+    [workerId, String(leaseMs)]
+  );
+  return { workerId, generation: Number(inserted.rows[0].generation) };
+}
+
+/** Renew only while the exact generation is still active under the PG clock. */
+export async function renewWorkerLease(
+  db: Queryable,
+  identity: WorkerLeaseIdentity,
+  leaseMs: number
+): Promise<boolean> {
+  const result = await db.query(
+    `UPDATE workflow.worker_leases
+     SET lease_until = now() + ($3::text || ' milliseconds')::interval,
+         updated_at = now()
+     WHERE worker_id = $1
+       AND generation = $2
+       AND NOT retired
+       AND lease_until >= now()
+     RETURNING generation`,
+    [identity.workerId, identity.generation, String(leaseMs)]
+  );
+  if (!result.rowCount) {
+    return false;
+  }
+  // Keep Graphile's lock timestamps fresh so the hardcoded 4h scanner cannot
+  // unlock a healthy long-running job that is still heartbeating.
+  await db.query(
+    `UPDATE graphile_worker._private_jobs
+     SET locked_at = now()
+     WHERE locked_by = $1`,
+    [identity.workerId]
+  );
+  await db.query(
+    `UPDATE graphile_worker._private_job_queues
+     SET locked_at = now()
+     WHERE locked_by = $1`,
+    [identity.workerId]
+  );
+  return true;
+}
+
+/**
+ * Irrevocably retire expired generations, then release their Graphile locks.
+ * Expiry always happens before unlock so a SIGSTOP'd owner cannot complete.
+ */
+export async function reclaimExpiredWorkerLeases(
+  pool: Pool
+): Promise<string[]> {
+  const client = await pool.connect();
+  try {
+    await client.query('BEGIN');
+    const expired = await client.query<{ worker_id: string }>(
+      `UPDATE workflow.worker_leases
+       SET retired = true,
+           generation = generation + 1,
+           updated_at = now()
+       WHERE NOT retired
+         AND lease_until < now()
+       RETURNING worker_id`
+    );
+    const workerIds = expired.rows.map((row) => row.worker_id);
+    if (workerIds.length > 0) {
+      await client.query(
+        `SELECT graphile_worker.force_unlock_workers($1::text[])`,
+        [workerIds]
+      );
+    }
+    await client.query('COMMIT');
+    return workerIds;
+  } catch (error) {
+    await client.query('ROLLBACK');
+    throw error;
+  } finally {
+    client.release();
+  }
+}
+
+/** No-op when no lease context is bound (non-worker callers). */
+export async function assertWorkerLeaseIfPresent(
+  db: Queryable
+): Promise<void> {
+  const identity = getWorkerLeaseContext();
+  if (!identity) {
+    return;
+  }
+  const result = await db.query(
+    `SELECT 1
+     FROM workflow.worker_leases
+     WHERE worker_id = $1
+       AND generation = $2
+       AND NOT retired
+       AND lease_until >= now()`,
+    [identity.workerId, identity.generation]
+  );
+  if (!result.rowCount) {
+    throw new WorkerLeaseFencedError();
+  }
+}
+
+export async function loadWorkerLease(
+  db: Queryable,
+  workerId: string,
+  generation: number
+): Promise<WorkerLeaseIdentity | undefined> {
+  const result = await db.query(
+    `SELECT 1
+     FROM workflow.worker_leases
+     WHERE worker_id = $1
+       AND generation = $2
+       AND NOT retired
+       AND lease_until >= now()`,
+    [workerId, generation]
+  );
+  if (!result.rowCount) {
+    return undefined;
+  }
+  return { workerId, generation };
+}
+
+/**
+ * Graphile Worker's completeJob deletes by job id only. Replace it with an
+ * owner-aware delete matching failJob, so a stale SIGSTOP'd owner cannot remove
+ * a job another worker holds.
+ */
+export function installOwnerAwareGraphileCompletion(): void {
+  const require = createRequire(import.meta.url);
+  const mod = require('graphile-worker/dist/sql/completeJob.js') as {
+    completeJob: (
+      compiledSharedOptions: any,
+      withPgClient: any,
+      workerId: string,
+      job: { id: string | number; job_queue_id?: number | null }
+    ) => Promise<void>;
+  };
+  if ((mod.completeJob as any).__workflowOwnerAware) {
+    return;
+  }
+  const original = mod.completeJob;
+  async function completeJob(
+    compiledSharedOptions: any,
+    withPgClient: any,
+    workerId: string,
+    job: { id: string | number; job_queue_id?: number | null }
+  ): Promise<void> {
+    const {
+      escapedWorkerSchema,
+      workerSchema,
+      resolvedPreset: {
+        worker: { preparedStatements },
+      },
+    } = compiledSharedOptions;
+    if (job.job_queue_id != null) {
+      await withPgClient.withRetries((client: PoolClient) =>
+        client.query({
+          text: `\
+with j as (
+delete from ${escapedWorkerSchema}._private_jobs as jobs
+where id = $1::bigint and locked_by = $2::text
+returning *
+)
+update ${escapedWorkerSchema}._private_job_queues as job_queues
+set locked_by = null, locked_at = null
+from j
+where job_queues.id = j.job_queue_id and job_queues.locked_by = $2::text;`,
+          values: [job.id, workerId],
+          name: !preparedStatements
+            ? undefined
+            : `complete_job_q_owned/${workerSchema}`,
+        })
+      );
+      return;
+    }
+    await withPgClient.withRetries((client: PoolClient) =>
+      client.query({
+        text: `\
+delete from ${escapedWorkerSchema}._private_jobs as jobs
+where id = $1::bigint and locked_by = $2::text`,
+        values: [job.id, workerId],
+        name: !preparedStatements
+          ? undefined
+          : `complete_job_owned/${workerSchema}`,
+      })
+    );
+  }
+  (completeJob as any).__workflowOwnerAware = true;
+  (completeJob as any).__workflowOriginalCompleteJob = original;
+  mod.completeJob = completeJob;
+}
diff --git a/packages/world-postgres/test/worker-lease.test.ts b/packages/world-postgres/test/worker-lease.test.ts
new file mode 100644
index 0000000..9c74294
--- /dev/null
+++ b/packages/world-postgres/test/worker-lease.test.ts
@@ -0,0 +1,215 @@
+import { randomUUID } from 'node:crypto';
+import { fileURLToPath } from 'node:url';
+import { setTimeout as sleep } from 'node:timers/promises';
+import { PostgreSqlContainer } from '@testcontainers/postgresql';
+import { drizzle } from 'drizzle-orm/node-postgres';
+import { migrate } from 'drizzle-orm/node-postgres/migrator';
+import { makeWorkerUtils } from 'graphile-worker';
+import { Pool } from 'pg';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import {
+  createWorld,
+  installOwnerAwareGraphileCompletion,
+  reclaimExpiredWorkerLeases,
+  registerWorkerLease,
+  renewWorkerLease,
+  runWithWorkerLease,
+  WorkerLeaseFencedError,
+} from '../dist/index.js';
+import { assertWorkerLeaseIfPresent } from '../dist/worker-lease.js';
+
+installOwnerAwareGraphileCompletion();
+
+function workerId(label: string) {
+  // Graphile requires worker ids with length >= 10.
+  return `worker-${label}-${randomUUID().replaceAll('-', '')}`;
+}
+
+describe('PGWorld worker lease fencing (real PostgreSQL)', () => {
+  let container: Awaited<ReturnType<PostgreSqlContainer['start']>>;
+  let pool: Pool;
+
+  beforeAll(async () => {
+    container = await new PostgreSqlContainer('postgres:15-alpine').start();
+    pool = new Pool({ connectionString: container.getConnectionUri() });
+    const config = {
+      migrationsFolder: fileURLToPath(
+        new URL('../src/drizzle/migrations', import.meta.url)
+      ),
+      migrationsTable: 'workflow_migrations',
+      migrationsSchema: 'workflow_drizzle',
+    };
+    await migrate(drizzle(pool), config);
+    const utils = await makeWorkerUtils({ pgPool: pool });
+    await utils.migrate();
+    await utils.release();
+  }, 120_000);
+
+  afterAll(async () => {
+    await pool?.end();
+    await container?.stop();
+  });
+
+  async function plantLockedJob(owner: string) {
+    const utils = await makeWorkerUtils({ pgPool: pool });
+    try {
+      const job = await utils.addJob('workflow_lease_probe', { ok: true });
+      await pool.query(
+        `UPDATE graphile_worker._private_jobs
+         SET locked_at = now(), locked_by = $2
+         WHERE id = $1`,
+        [job.id, owner]
+      );
+      return job.id;
+    } finally {
+      await utils.release();
+    }
+  }
+
+  it('reclaims abandoned Graphile work for a dead lock owner after irrevocable generation expiry', async () => {
+    const dead = workerId('dead');
+    const identity = await registerWorkerLease(pool, dead, 1_000);
+    const jobId = await plantLockedJob(dead);
+
+    await pool.query(
+      `UPDATE workflow.worker_leases
+       SET lease_until = now() - interval '1 millisecond'
+       WHERE worker_id = $1 AND generation = $2`,
+      [dead, identity.generation]
+    );
+
+    const reclaimed = await reclaimExpiredWorkerLeases(pool);
+    expect(reclaimed).toContain(dead);
+
+    const lease = await pool.query<{ generation: string; retired: boolean }>(
+      `SELECT generation::text, retired FROM workflow.worker_leases WHERE worker_id = $1`,
+      [dead]
+    );
+    expect(lease.rows[0]?.retired).toBe(true);
+    expect(Number(lease.rows[0]?.generation)).toBe(identity.generation + 1);
+
+    const unlocked = await pool.query(
+      `SELECT locked_by FROM graphile_worker._private_jobs WHERE id = $1`,
+      [jobId]
+    );
+    expect(unlocked.rows[0]?.locked_by).toBeNull();
+
+    // Bounded recovery path is reclaim+unlock; wake publication is not claimed.
+    expect(await renewWorkerLease(pool, identity, 1_000)).toBe(false);
+    await expect(
+      runWithWorkerLease(identity, () => assertWorkerLeaseIfPresent(pool))
+    ).rejects.toBeInstanceOf(WorkerLeaseFencedError);
+  }, 60_000);
+
+  it('keeps a healthy heartbeating lock; reclaim does not false-unlock it', async () => {
+    const live = workerId('live');
+    const identity = await registerWorkerLease(pool, live, 3_000);
+    await plantLockedJob(live);
+
+    for (let i = 0; i < 3; i++) {
+      await sleep(800);
+      expect(await renewWorkerLease(pool, identity, 3_000)).toBe(true);
+    }
+
+    const reclaimed = await reclaimExpiredWorkerLeases(pool);
+    expect(reclaimed).not.toContain(live);
+
+    const still = await pool.query(
+      `SELECT locked_by FROM graphile_worker._private_jobs WHERE locked_by = $1`,
+      [live]
+    );
+    expect(still.rows.length).toBeGreaterThan(0);
+  }, 60_000);
+
+  it('stale complete/fail from an old owner cannot delete or release the current owner', async () => {
+    const oldOwner = workerId('old');
+    const newOwner = workerId('new');
+    await registerWorkerLease(pool, oldOwner, 1_000);
+    await registerWorkerLease(pool, newOwner, 30_000);
+    const jobId = await plantLockedJob(newOwner);
+
+    const staleComplete = await pool.query(
+      `DELETE FROM graphile_worker._private_jobs
+       WHERE id = $1 AND locked_by = $2
+       RETURNING id`,
+      [jobId, oldOwner]
+    );
+    expect(staleComplete.rows).toHaveLength(0);
+
+    const afterComplete = await pool.query(
+      `SELECT locked_by FROM graphile_worker._private_jobs WHERE id = $1`,
+      [jobId]
+    );
+    expect(afterComplete.rows).toHaveLength(1);
+    expect(afterComplete.rows[0].locked_by).toBe(newOwner);
+
+    const staleFail = await pool.query(
+      `UPDATE graphile_worker._private_jobs
+       SET locked_by = null, locked_at = null, last_error = 'stale'
+       WHERE id = $1 AND locked_by = $2
+       RETURNING id`,
+      [jobId, oldOwner]
+    );
+    expect(staleFail.rows).toHaveLength(0);
+
+    const afterFail = await pool.query(
+      `SELECT locked_by FROM graphile_worker._private_jobs WHERE id = $1`,
+      [jobId]
+    );
+    expect(afterFail.rows[0].locked_by).toBe(newOwner);
+
+    const ownerComplete = await pool.query(
+      `DELETE FROM graphile_worker._private_jobs
+       WHERE id = $1 AND locked_by = $2
+       RETURNING id`,
+      [jobId, newOwner]
+    );
+    expect(ownerComplete.rows).toHaveLength(1);
+  }, 60_000);
+
+  it('world reclaim loop unlocks abandoned work without manual forceUnlock', async () => {
+    const dead = workerId('orphan');
+    await registerWorkerLease(pool, dead, 500);
+    await pool.query(
+      `UPDATE workflow.worker_leases
+       SET lease_until = now() - interval '1 second'
+       WHERE worker_id = $1`,
+      [dead]
+    );
+    await plantLockedJob(dead);
+
+    const world = createWorld({
+      pool,
+      applicationManagedShutdown: true,
+      queueConcurrency: 1,
+      workerLease: {
+        leaseMs: 2_000,
+        heartbeatMs: 500,
+        reclaimIntervalMs: 400,
+      },
+    });
+    await world.start();
+    try {
+      let unlocked = false;
+      for (let i = 0; i < 25; i++) {
+        const rows = await pool.query(
+          `SELECT 1 FROM graphile_worker._private_jobs WHERE locked_by = $1`,
+          [dead]
+        );
+        if (rows.rows.length === 0) {
+          unlocked = true;
+          break;
+        }
+        await sleep(250);
+      }
+      expect(unlocked).toBe(true);
+      const lease = await pool.query(
+        `SELECT retired FROM workflow.worker_leases WHERE worker_id = $1`,
+        [dead]
+      );
+      expect(lease.rows[0]?.retired).toBe(true);
+    } finally {
+      await world.close();
+    }
+  }, 90_000);
+});
