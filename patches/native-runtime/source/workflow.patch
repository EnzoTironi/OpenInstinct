+import { fork } from 'node:child_process';
+import { createHash, randomUUID } from 'node:crypto';
+import { once } from 'node:events';
+import { fileURLToPath } from 'node:url';
+import { PostgreSqlContainer } from '@testcontainers/postgresql';
+import { WorkflowWorldError } from '@workflow/errors';
+import type { CreateEventParams, Event, World } from '@workflow/world';
+import { eventIdToSlot } from '@workflow/world';
+import { drizzle } from 'drizzle-orm/node-postgres';
+import { migrate } from 'drizzle-orm/node-postgres/migrator';
+import { Pool } from 'pg';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import { createWorld } from '../dist/index.js';
+import {
+  createAcceptanceFixture,
+  readAcceptedHooks,
+} from './hook-acceptance-fixture.js';
+
+describe('durable hook acceptance (real PostgreSQL)', () => {
+  let container: Awaited<ReturnType<PostgreSqlContainer['start']>>;
+  let pool: Pool;
+  let world: World;
+  let connectionString: string;
+
+  beforeAll(async () => {
+    container = await new PostgreSqlContainer('postgres:15-alpine').start();
+    connectionString = container.getConnectionUri();
+    pool = new Pool({ connectionString });
+    const config = {
+      migrationsFolder: fileURLToPath(
+        new URL('../src/drizzle/migrations', import.meta.url)
+      ),
+      migrationsTable: 'workflow_migrations',
+      migrationsSchema: 'workflow_drizzle',
+    };
+    await migrate(drizzle(pool), config);
+    await migrate(drizzle(pool), config);
+    world = createWorld({ pool, applicationManagedShutdown: true });
+  }, 120_000);
+
+  afterAll(async () => {
+    await world?.close?.();
+    await pool?.end();
+    await container?.stop();
+  });
+
+  function request(
+    hook: { hookId: string; token: string },
+    payload = 'semantic input',
+    resumeId = randomUUID()
+  ) {
+    return {
+      data: {
+        eventType: 'hook_received' as const,
+        correlationId: hook.hookId,
+        eventData: { token: hook.token, payload },
+      },
+      params: {
+        resumeId,
+        resumePayloadDigest: createHash('sha256')
+          .update(JSON.stringify(payload))
+          .digest('hex'),
+      },
+    };
+  }
+
+  async function childAccept(
+    runId: string,
+    input: ReturnType<typeof request>,
+    park = false
+  ) {
+    const child = fork(
+      fileURLToPath(new URL('./hook-acceptance-child.mjs', import.meta.url)),
+      [],
+      { stdio: ['ignore', 'inherit', 'inherit', 'ipc'] }
+    );
+    const exit = once(child, 'exit');
+    try {
+      const response = new Promise<{ event: Event }>((resolve, reject) => {
+        const timer = setTimeout(
+          () => reject(new Error('Child acceptance timed out')),
+          15_000
+        );
+        child.once('message', (message: { event: Event; error?: string }) => {
+          clearTimeout(timer);
+          if (message.error) reject(new Error(message.error));
+          else resolve(message);
+        });
+        child.once('error', reject);
+      });
+      child.send({ connectionString, runId, ...input, park });
+      const result = await response;
+      if (park) child.kill('SIGKILL');
+      const [code, signal] = await exit;
+      expect(park ? signal : code).toBe(park ? 'SIGKILL' : 0);
+      return result.event;
+    } finally {
+      if (child.exitCode === null && child.signalCode === null)
+        child.kill('SIGKILL');
+    }
+  }
+
+  it('keeps one canonical event across commit, process kill, and independent retry', async () => {
+    const hook = await createAcceptanceFixture(world);
+    const input = request(hook);
+    const first = await childAccept(hook.runId, input, true);
+    const second = await childAccept(hook.runId, input);
+    expect(second).toEqual(first);
+    expect(await readAcceptedHooks(world, hook.runId)).toHaveLength(1);
+    expect(
+      await world.events.getResume!(hook.runId, input.params.resumeId)
+    ).toEqual({
+      runId: hook.runId,
+      eventId: first.eventId,
+      hookId: hook.hookId,
+      token: hook.token,
+      resumeId: input.params.resumeId,
+      payloadDigest: input.params.resumePayloadDigest,
+    });
+    expect(
+      await world.events.getResume!(randomUUID(), input.params.resumeId)
+    ).toBeUndefined();
+    expect(await world.events.getResume!(hook.runId, 'absent')).toBeUndefined();
+  }, 30_000);
+
+  it('rejects changed semantic content, hook, or token without another append', async () => {
+    const hook = await createAcceptanceFixture(world);
+    const input = request(hook);
+    await world.events.create(hook.runId, input.data, input.params);
+    const changed = request(
+      hook,
+      'changed semantic input',
+      input.params.resumeId
+    );
+    for (const data of [
+      changed,
+      { ...input, data: { ...input.data, correlationId: 'other-hook' } },
+      {
+        ...input,
+        data: {
+          ...input.data,
+          eventData: { ...input.data.eventData, token: 'other-token' },
+        },
+      },
+    ]) {
+      await expect(
+        world.events.create(hook.runId, data.data, data.params)
+      ).rejects.toMatchObject({ status: 422 });
+    }
+    expect(await readAcceptedHooks(world, hook.runId)).toHaveLength(1);
+  });
+
+  it('rejects cross-run hooks for keyed and ordinary receives', async () => {
+    const own = await createAcceptanceFixture(world);
+    const foreign = await createAcceptanceFixture(world);
+    const input = request(foreign);
+    await expect(
+      world.events.create(own.runId, input.data, input.params)
+    ).rejects.toThrow();
+    await expect(world.events.create(own.runId, input.data)).rejects.toThrow();
+    expect(await readAcceptedHooks(world, own.runId)).toHaveLength(0);
+    expect(await readAcceptedHooks(world, foreign.runId)).toHaveLength(0);
+    expect(
+      await world.events.getResume!(own.runId, input.params.resumeId)
+    ).toBeUndefined();
+  });
+
+  it('rejects a forged token on first acceptance without claiming the key', async () => {
+    const hook = await createAcceptanceFixture(world);
+    const forged = request({ ...hook, token: 'forged-token' });
+    await expect(
+      world.events.create(hook.runId, forged.data, forged.params)
+    ).rejects.toMatchObject({ status: 422 });
+    expect(await readAcceptedHooks(world, hook.runId)).toHaveLength(0);
+    expect(
+      await world.events.getResume!(hook.runId, forged.params.resumeId)
+    ).toBeUndefined();
+    const valid = request(hook, 'semantic input', forged.params.resumeId);
+    const accepted = await world.events.create(
+      hook.runId,
+      valid.data,
+      valid.params
+    );
+    expect(
+      await world.events.getResume!(hook.runId, valid.params.resumeId)
+    ).toMatchObject({ token: hook.token, eventId: accepted.event!.eventId });
+    expect(await readAcceptedHooks(world, hook.runId)).toHaveLength(1);
+  });
+
+  it('converges concurrent claims while preserving distinct keys and contiguous slots', async () => {
+    const hook = await createAcceptanceFixture(world);
+    const inputs = [request(hook), request(hook)];
+    const results = await Promise.all(
+      Array.from({ length: 12 }, (_, i) => {
+        const input = inputs[i % 2];
+        return world.events.create(hook.runId, input.data, input.params);
+      })
+    );
+    expect(new Set(results.map((result) => result.event!.eventId)).size).toBe(
+      2
+    );
+    expect(await readAcceptedHooks(world, hook.runId)).toHaveLength(2);
+    const page = await world.events.list({ runId: hook.runId });
+    expect(page.data.map((event) => eventIdToSlot(event.eventId))).toEqual(
+      page.data.map((_, i) => i + 1)
+    );
+  });
+
+  it('validates complete key/digest pairs and rejects keyed legacy requests', async () => {
+    const hook = await createAcceptanceFixture(world);
+    const input = request(hook);
+    const invalid: CreateEventParams[] = [
+      { resumeId: '', resumePayloadDigest: input.params.resumePayloadDigest },
+      { ...input.params, resumeId: 'x'.repeat(257) },
+      { resumeId: 'key' },
+      { resumePayloadDigest: input.params.resumePayloadDigest },
+      { ...input.params, resumePayloadDigest: 'A'.repeat(64) },
+      { ...input.params, resumePayloadDigest: 'a'.repeat(63) },
+    ];
+    for (const params of invalid) {
+      await expect(
+        world.events.create(hook.runId, input.data, params)
+      ).rejects.toMatchObject({ status: 422 });
+    }
+    await expect(
