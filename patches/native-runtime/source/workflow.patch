+import { randomUUID } from 'node:crypto';
+import type { World } from '@workflow/world';
+import { expect } from 'vitest';
+
+export async function createAcceptanceFixture(world: World) {
+  const created = await world.events.create(null, {
+    eventType: 'run_created',
+    eventData: {
+      deploymentId: 'dpl_acceptance',
+      workflowName: 'acceptance',
+      input: new Uint8Array(),
+      executionContext: { workflowCoreVersion: '5.0.0-beta.47' },
+    },
+  });
+  const runId = created.run!.runId;
+  await world.events.create(runId, { eventType: 'run_started' });
+  const hookId = `hook_${randomUUID()}`;
+  const token = `token_${randomUUID()}`;
+  await world.events.create(runId, {
+    eventType: 'hook_created',
+    correlationId: hookId,
+    eventData: { token },
+  });
+  return { runId, hookId, token };
+}
+
+/** Assert that these bounded keyed fixtures expose complete, identified events. */
+export async function readAcceptedHooks(world: World, runId: string) {
+  const page = await world.events.list({ runId });
+  expect(page.hasMore).toBe(false);
+  const accepted = page.data.filter(
+    (event) => event.eventType === 'hook_received'
+  );
+  for (const event of accepted) {
+    expect(event.resumeId).toEqual(expect.any(String));
+    expect(event.runId).toBe(runId);
+  }
+  return accepted;
+}
