+      "SELECT 1 FROM graphile_worker._private_jobs WHERE convert_from(decode(payload->>'data', 'base64'), 'UTF8')::jsonb->>'runId' = $1",
+      [hook.runId]
+    );
+    expect(unpublished.rows).toHaveLength(0);
