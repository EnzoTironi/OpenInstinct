+import { createWorld } from '../dist/index.js';
+import {
+  resumeHook,
+  recoverHookResume,
+  setWorld,
+} from '../../core/dist/runtime.js';
+process.env.PORT = '0';
+process.once(
+  'message',
+  async ({ connectionString, token, payload, options, recovery }) => {
+    const world = createWorld({
+      connectionString,
+      applicationManagedShutdown: true,
+    });
+    setWorld(world);
+    try {
+      const receipt = recovery
+        ? await recoverHookResume(options)
+        : await resumeHook(token, payload, undefined, options);
+      process.send({ receipt });
+    } catch (error) {
+      process.send({ error: String(error) });
+      process.exitCode = 1;
+    } finally {
+      await world.close();
+      process.disconnect();
+    }
+  }
+);
