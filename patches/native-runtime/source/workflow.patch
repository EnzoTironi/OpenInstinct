+      [],
+      {
+        stdio: ['ignore', 'inherit', 'inherit', 'ipc'],
+      }
+    );
+    const retriedExit = once(retry, 'exit');
+    const response = once(retry, 'message');
+    retry.send({
+      connectionString,
+      recovery: true,
+      options,
+    });
+    try {
+      expect((await response)[0]).toEqual({ receipt: canonical });
+      expect((await retriedExit)[0]).toBe(0);
+    } finally {
+      if (retry.exitCode === null) retry.kill('SIGKILL');
+    }
+    expect(await readAcceptedHooks(world, hook.runId)).toHaveLength(1);
+    const jobs = await pool.query(
+      "SELECT convert_from(decode(payload->>'data', 'base64'), 'UTF8')::jsonb AS body FROM graphile_worker._private_jobs"
+    );
