+import { describe, expect, it } from 'vitest';
+import { snapshotResumeInput } from './resume-input.js';
+
+describe('keyed resume input snapshot', () => {
+  it('canonicalizes key order while preserving content and array order', () => {
+    const first = snapshotResumeInput({
+      b: [2, 1],
+      a: { y: true, x: 'hello' },
+    });
+    const reordered = snapshotResumeInput({
+      a: { x: 'hello', y: true },
+      b: [2, 1],
+    });
+    expect(first.bytes).toEqual(reordered.bytes);
+    expect(first.payload).toEqual({ a: { x: 'hello', y: true }, b: [2, 1] });
+    expect(first.bytes).not.toEqual(
+      snapshotResumeInput({ a: { x: 'hello', y: true }, b: [1, 2] }).bytes
+    );
+  });
+
+  it('snapshots the actual input independently of subsequent caller mutation', () => {
+    const input = { action: { recipient: 'alice' }, context: ['original'] };
+    const saved = snapshotResumeInput(input);
+    input.action.recipient = 'bob';
+    input.context.push('changed');
+    expect(saved.payload).toEqual({
+      action: { recipient: 'alice' },
+      context: ['original'],
+    });
+    expect(saved.bytes).toEqual(snapshotResumeInput(saved.payload).bytes);
+  });
+
+  it('does not execute accessors or toJSON while computing the accepted input', () => {
+    const input = {
+      get value() {
+        throw new Error('accessor executed');
+      },
+    };
+    expect(() => snapshotResumeInput(input)).toThrow('accessors');
+    expect(() => snapshotResumeInput(new Date())).toThrow('plain JSON');
+    expect(() =>
+      snapshotResumeInput({
+        toJSON() {
+          throw new Error('toJSON executed');
+        },
+      })
+    ).toThrow('finite JSON');
+  });
+
+  it('rejects unsupported payloads and cycles instead of silently changing semantics', () => {
+    const cycle: { self?: unknown } = {};
+    cycle.self = cycle;
+    for (const input of [
+      NaN,
+      Infinity,
+      1n,
+      [undefined],
+      new Uint8Array([1]),
+      new Map(),
+      cycle,
+    ]) {
+      expect(() => snapshotResumeInput(input)).toThrow(TypeError);
+    }
