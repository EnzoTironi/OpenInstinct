+    await recoverHookResume({ ...key, inputId: randomUUID() })
+  ).toBeUndefined();
+  await expect(
+    recoverHookResume({ ...key, scope: randomUUID() })
+  ).rejects.toThrow('recovery scope');
+  const after = await pool.query(
+    'SELECT count(*)::int AS count FROM graphile_worker._private_jobs'
+  );
