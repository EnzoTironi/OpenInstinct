+    inputId: randomUUID(),
+    scope: randomUUID(),
+  };
+  const barrier = await pool.connect();
+  const producerName = `core-prewake-${randomUUID()}`;
+  const producerUrl = new URL(connectionString);
+  producerUrl.searchParams.set('application_name', producerName);
+  const child = fork(
+    fileURLToPath(new URL('./core-acceptance-child.mjs', import.meta.url)),
+    [],
+    {
+      stdio: ['ignore', 'inherit', 'inherit', 'ipc'],
+    }
+  );
+  const exited = once(child, 'exit');
+  let childMessage: unknown;
+  child.on('message', (message) => {
+    childMessage = message;
+  });
+  try {
+    await barrier.query('BEGIN');
+    await barrier.query(
+      'LOCK TABLE graphile_worker._private_jobs IN ACCESS EXCLUSIVE MODE'
+    );
+    child.send({
+      connectionString: producerUrl.toString(),
+      token: hook.token,
+      payload: { text: 'persisted' },
+      options,
+    });
+    let canonical;
+    let queueBlocked = false;
+    const deadline = Date.now() + 15_000;
+    while (Date.now() < deadline) {
+      if (childMessage)
+        throw new Error(
+          `Child returned before queue barrier: ${JSON.stringify(childMessage)}`
+        );
