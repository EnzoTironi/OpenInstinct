+  } finally {
+    if (child.exitCode === null && child.signalCode === null)
+      child.kill('SIGKILL');
+    await barrier.query('ROLLBACK');
+    barrier.release();
+  }
+}, 30_000);
+
+it('recovery reads native proof, rejects wrong scopes, and does not wake terminal or absent inputs', async () => {
+  const hook = await createAcceptanceFixture(world);
+  const key = { runId: hook.runId, inputId: randomUUID(), scope: randomUUID() };
+  const receipt = await resumeHook(
