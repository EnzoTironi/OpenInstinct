@@ -0,0 +1,72 @@
+import { expect, test } from "vitest";
+import { createChannelOperations } from "#channel/channel-operations.js";
+import { createWorkflowRuntime } from "#execution/workflow-runtime.js";
+import type { Runtime } from "#channel/types.js";
+
+test("receive attaches the canonical ID synchronously without touching runtime or address ownership", () => {
+  const runtime = new Proxy(
+    createWorkflowRuntime({ compiledArtifactsSource: { kind: "bundled" } }),
+    {
+      get(_target, property) {
+        throw new Error(`Attachment must not access runtime.${String(property)}`);
+      },
+    },
+  );
+  const context = createChannelOperations({
+    adapter: { kind: "private" },
+    channelName: "private",
+    runtime,
+  });
+  const session = context.attachSession("canonical-retired-session");
+  expect(session.id).toBe("canonical-retired-session");
+  expect(session).not.toBeInstanceOf(Promise);
+  expect(session.acceptedInput).toBeUndefined();
+  expect(typeof session.getEventStream).toBe("function");
+});
+
+test("an attached handle forwards channel metadata and default policy on explicit dispatch", async () => {
+  const stopped = new Error("Dispatch boundary reached; no I/O or acceptance is simulated");
+  const commands: Parameters<Runtime["dispatchSession"]>[0][] = [];
+  const runtime = new Proxy(
+    createWorkflowRuntime({ compiledArtifactsSource: { kind: "bundled" } }),
+    {
+      get(_target, property) {
+        if (property !== "dispatchSession")
+          throw new Error(`Unexpected runtime.${String(property)}`);
+        return (command: Parameters<Runtime["dispatchSession"]>[0]) => {
+          commands.push(command);
+          throw stopped;
+        };
+      },
+    },
+  );
+  const metadata = {
+    channelKind: "private",
+    channelName: "private",
+    requestId: "request-current",
+    acceptedDeploymentId: "deployment-current",
+  };
+  const context = createChannelOperations({
+    adapter: { kind: "private" },
+    channelName: "private",
+    runtime,
+    metadata,
+    turnPolicy: "queue",
+  });
+  const session = context.attachSession("canonical-retired-session");
+  expect(commands).toEqual([]);
+  await expect(session.send("follow-up", { auth: null })).rejects.toBe(stopped);
+  expect(commands).toHaveLength(1);
+  expect(commands[0]).toMatchObject({
+    sessionId: "canonical-retired-session",
+    command: {
+      kind: "send",
+      payload: { message: "follow-up" },
+      requestId: metadata.requestId,
+      turnPolicy: "queue",
+      delivery: metadata,
+    },
+  });
+  if (commands[0]?.command.kind !== "send") throw new Error("Expected native send command");
+  expect(commands[0].command.delivery?.deliveryId).toEqual(expect.any(String));
+});
