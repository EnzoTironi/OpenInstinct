+type SendCommand = Extract<SessionCommand, { readonly kind: "send" }>;
+export interface SessionInputIdentity {
+  readonly auth: SessionAuthContext | null | undefined;
+  /** Fully namespaced continuation token, or the stable fixed-session token. */
+  readonly targetToken: string;
+  readonly inputId: string;
+}
+
+export interface InitialInputBootstrap {
+  readonly scope: string;
+  readonly inputId: string;
+  readonly configDigest: string;
+}
+
+/** Only a fingerprint crosses into hook metadata; state and auth remain in the run payload. */
+export function inputCreationDigest(
+  input: Pick<
+    RunInput,
+    "adapter" | "auth" | "capabilities" | "initiatorAuth" | "mode" | "title" | "activityObserver"
+  >,
+): string {
+  const snapshot = snapshotResumeInput({
+    mode: input.mode,
+    requestInput: input.capabilities?.requestInput === true,
+    state: input.adapter.state,
+    initiatorAuth: input.initiatorAuth ?? input.auth,
+    title: input.title,
+    activityObserver: input.activityObserver,
+  });
+  return createHash("sha256").update(snapshot.bytes).digest("hex");
+}
+
+/** The authenticated principal and exact destination own the recovery namespace. */
+export function inputAcceptanceScope(input: SessionInputIdentity): string {
+  if (
+    !input.auth ||
+    input.auth.principalType === "anonymous" ||
+    [input.auth.authenticator, input.auth.principalType, input.auth.principalId].some(
+      (part) => typeof part !== "string" || !part || part.length > 2048,
+    )
+  ) {
+    throw new WorkflowWorldError("Stable input identity requires an authenticated principal.", {
+      status: 403,
+    });
+  }
+  if (typeof input.inputId !== "string" || !input.inputId || input.inputId.length > 256) {
+    throw new WorkflowWorldError("inputId must contain 1–256 characters.", { status: 400 });
+  }
+  if (
+    typeof input.targetToken !== "string" ||
+    !input.targetToken ||
+    input.targetToken.length > 4096
+  ) {
+    throw new WorkflowWorldError("Invalid input acceptance destination.", { status: 400 });
+  }
+  const identity = JSON.stringify([
+    "eve:input-acceptance:v1",
+    input.auth.authenticator,
+    input.auth.issuer ?? null,
+    input.auth.principalType,
+    input.auth.principalId,
+    input.targetToken,
+  ]);
+  return createHash("sha256").update(identity).digest("hex");
+}
+
+/** Native per-run keys must preserve the same principal/destination isolation as lookup. */
+function nativeInputKey(scope: string, inputId: string): string {
+  return createHash("sha256")
