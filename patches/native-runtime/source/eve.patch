new file mode 100644
index 0000000..627c77d
--- /dev/null
+++ b/packages/eve/src/execution/input-acceptance-step.ts
@@ -0,0 +1,31 @@
+import { WorkflowWorldError } from "#compiled/@workflow/errors/index.js";
+import type { SessionCommand, SessionInputReceipt } from "#channel/types.js";
+import { acceptSessionInput, readSessionInputReceipt } from "#execution/input-acceptance.js";
+
+/** Bootstrap runs the accepted inbox input even when another request won its input key. */
+export async function acceptInitialSessionInputStep(input: {
+  readonly command: Extract<SessionCommand, { readonly kind: "send" }>;
+  readonly continuationToken: string;
+  readonly sessionId: string;
+}): Promise<SessionInputReceipt> {
+  "use step";
+  const inputId = input.command.inputId;
+  if (inputId === undefined) throw new TypeError("Initial acceptance requires inputId.");
+  const identity = { auth: input.command.auth, targetToken: input.continuationToken, inputId };
+  const accepted = await readSessionInputReceipt(identity);
+  if (accepted !== undefined) return accepted;
+  try {
+    return await acceptSessionInput({
+      targetToken: input.continuationToken,
+      bootstrapSessionId: input.sessionId,
+      command: input.command,
+    });
+  } catch (error) {
+    // A concurrent input can win after lookup. This step only establishes the
+    // driver's accepted owner; the transport still validates its own content.
+    if (!WorkflowWorldError.is(error) || error.status !== 422) throw error;
+    const winner = await readSessionInputReceipt(identity);
+    if (winner === undefined) throw error;
+    return winner;
+  }
+}
diff --git a/packages/eve/src/execution/input-acceptance.test.ts b/packages/eve/src/execution/input-acceptance.test.ts
new file mode 100644
index 0000000..353ef88
--- /dev/null
+++ b/packages/eve/src/execution/input-acceptance.test.ts
@@ -0,0 +1,172 @@
+import { resumeHook } from "#internal/workflow/runtime.js";
+import { parseCreateBody, parseSessionMessageBody } from "#eve-channel/request.js";
+import { describe, expect, it } from "vitest";
+import {
+  acceptedInputWire,
+  inputAcceptanceScope,
+  inputCreationDigest,
+} from "#execution/input-acceptance.js";
+import type { SessionCommand } from "#channel/types.js";
+
+const auth = {
+  authenticator: "http-basic",
+  principalId: "alice",
+  principalType: "user",
+  attributes: {},
+};
+const identity = { auth, targetToken: "web:conversation", inputId: "input-1" };
+const command: Extract<SessionCommand, { kind: "send" }> = {
+  auth,
+  kind: "send",
+  inputId: identity.inputId,
+  payload: { message: "Hello", context: ["context"], outputSchema: { type: "string" } },
+  delivery: {
+    channelKind: "channel",
+    channelName: "web",
+    deliveryId: "attempt-1",
+    requestId: "request-1",
+    acceptedDeploymentId: "deployment-1",
+  },
+  requestId: "request-1",
+  turnPolicy: "steer",
+  caller: {
+    callId: "call-1",
+    subagentName: "child",
+    replyTo: { kind: "callback", token: "callback-1", url: "https://example.com/callback" },
+  },
+};
+
+describe("native input identity semantics", () => {
+  it("binds the effective creation configuration using canonical native JSON", () => {
+    const creation: Parameters<typeof inputCreationDigest>[0] = {
+      adapter: { kind: "http", state: { locale: "en", nested: { a: 1, b: 2 } } },
+      auth,
+      mode: "conversation",
+      capabilities: { requestInput: true },
+    };
+    const digest = inputCreationDigest(creation);
+    expect(inputCreationDigest({ ...creation, initiatorAuth: auth })).toBe(digest);
+    expect(
+      inputCreationDigest({
+        ...creation,
+        adapter: { kind: "http", state: { nested: { b: 2, a: 1 }, locale: "en" } },
+      }),
+    ).toBe(digest);
+    for (const changed of [
+      { ...creation, mode: "task" as const },
+      { ...creation, capabilities: { requestInput: false } },
+      { ...creation, adapter: { kind: "http", state: { locale: "fr" } } },
+      { ...creation, initiatorAuth: { ...auth, principalId: "bob" } },
+      { ...creation, title: "Another title" },
+      {
+        ...creation,
+        activityObserver: { sink: { version: 1 as const, url: "https://example.com/activity" } },
+      },
+    ])
+      expect(inputCreationDigest(changed)).not.toBe(digest);
+    expect(inputCreationDigest({ ...creation, capabilities: undefined })).toBe(
+      inputCreationDigest({ ...creation, capabilities: { requestInput: false } }),
+    );
+    const scope = inputAcceptanceScope(identity);
+    expect(acceptedInputWire({ ...command, creationConfigDigest: digest }, scope)).not.toEqual(
+      acceptedInputWire(
+        { ...command, creationConfigDigest: inputCreationDigest({ ...creation, mode: "task" }) },
+        scope,
+      ),
+    );
+  });
+
+  it("scopes recovery by authenticated principal and exact target, independently of the per-scope input key", () => {
+    const scope = inputAcceptanceScope(identity);
+    expect(inputAcceptanceScope({ ...identity, inputId: "input-2" })).toBe(scope);
+    for (const changed of [
+      { ...identity, auth: { ...auth, principalId: "bob" } },
+      { ...identity, auth: { ...auth, authenticator: "jwt" } },
+      { ...identity, auth: { ...auth, issuer: "another-issuer" } },
+      { ...identity, targetToken: "web:another-conversation" },
+    ])
+      expect(inputAcceptanceScope(changed)).not.toBe(scope);
+  });
+
+  it("rejects anonymous, malformed and unbounded identities", () => {
+    for (const changed of [
+      { ...identity, auth: null },
+      { ...identity, auth: { ...auth, principalType: "anonymous" } },
+      { ...identity, auth: { ...auth, principalId: "" } },
+      { ...identity, inputId: "" },
+      { ...identity, inputId: "x".repeat(257) },
+      { ...identity, targetToken: "x".repeat(4097) },
+    ])
+      expect(() => inputAcceptanceScope(changed)).toThrow();
+  });
+
+  it("removes attempt metadata while preserving semantic input and deterministic delivery identity", () => {
+    const scope = inputAcceptanceScope(identity);
+    const wire = acceptedInputWire(command, scope);
+    expect(
+      acceptedInputWire(
+        {
+          ...command,
+          requestId: "retry",
+          delivery: {
+            ...command.delivery!,
+            deliveryId: "attempt-2",
+            requestId: "retry",
+            acceptedDeploymentId: "deployment-2",
+            requestTraceContext: { traceId: "a".repeat(32), spanId: "b".repeat(16), traceFlags: 1 },
+          },
+        },
+        scope,
+      ),
+    ).toEqual(wire);
+    expect(wire.kind).toBe("deliver");
+    if (wire.kind !== "deliver") throw new Error("Expected delivery");
+    expect(wire.deliveryMetadata?.[0]?.deliveryId).toBe(`${scope}:${identity.inputId}`);
+    expect(wire.requestId).toBeUndefined();
+    for (const changed of [
+      { ...command, payload: { ...command.payload, message: "Different" } },
+      { ...command, payload: { ...command.payload, context: ["different context"] } },
+      { ...command, payload: { ...command.payload, outputSchema: { type: "number" } } },
+      { ...command, auth: { ...auth, attributes: { role: "another-role" } } },
+      { ...command, caller: { ...command.caller!, callId: "different callback" } },
+    ])
+      expect(acceptedInputWire(changed, scope)).not.toEqual(wire);
+  });
+
+  it("rejects binary wire content at native keyed validation before consulting a World", async () => {
+    const wire = acceptedInputWire(
+      {
+        ...command,
+        payload: {
+          message: [{ type: "image", image: new Uint8Array([1, 2, 3]), mediaType: "image/png" }],
+        },
+      },
+      inputAcceptanceScope(identity),
+    );
+    await expect(
+      resumeHook("unused-for-invalid-json", wire, undefined, {
+        runId: "unused-for-invalid-json",
+        inputId: identity.inputId,
+      }),
+    ).rejects.toThrow("plain JSON objects");
+  });
+
+  it("bounds both HTTP creation and fixed-session identities", () => {
+    for (const inputId of ["", "x".repeat(257), 42, null]) {
+      for (const parsed of [
+        parseCreateBody({ message: "Hello", operationId: inputId }),
+        parseSessionMessageBody({ message: "Hello", inputId }),
+      ]) {
+        expect(parsed).toBeInstanceOf(Response);
+        if (!(parsed instanceof Response)) throw new Error("Expected rejection");
+        expect(parsed.status).toBe(400);
+      }
+    }
+    for (const inputId of ["x", "x".repeat(256)]) {
+      expect(parseCreateBody({ message: "Hello", operationId: inputId })).toMatchObject({
+        operationId: inputId,
+      });
+      expect(parseSessionMessageBody({ message: "Hello", inputId })).toMatchObject({ inputId });
+    }
+  });
+});
