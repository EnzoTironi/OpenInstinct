+          { status: 422 },
+        );
+      }
+      const initial = metadata?.initialInput;
+      if (
+        isObject(initial) &&
+        initial.scope === scope &&
+        initial.inputId === inputId &&
+        initial.configDigest !== input.command.creationConfigDigest
+      ) {
+        throw new WorkflowWorldError(
+          "Input creation configuration conflicts with its native owner.",
+          { status: 422 },
+        );
+      }
+      if (input.bootstrapSessionId !== undefined && hook.runId !== input.bootstrapSessionId) {
+        throw new WorkflowWorldError("Initial input does not own the claimed continuation.", {
+          status: 422,
+        });
+      }
+    }
+    return await resumeHook(accepted?.token ?? hook!.token, wire, undefined, {
+      runId: accepted?.runId ?? hook!.runId,
+      inputId: key,
+      scope,
+    });
+  };
+  let receipt;
+  try {
+    receipt = await resume();
+  } catch (error) {
+    // A competing commit may have happened before disposal or a scope conflict.
+    if (!HookNotFoundError.is(error) && !(WorkflowWorldError.is(error) && error.status === 422))
+      throw error;
+    const committed = await getResumeByScope(scope, key);
+    if (committed === undefined) throw error;
+    receipt = await resumeHook(committed.token, wire, undefined, {
+      runId: committed.runId,
+      inputId: key,
+      scope,
+    });
+  }
+  return {
+    sessionId: receipt.runId,
+    inputId,
+    eventId: receipt.eventId,
+    payloadDigest: receipt.payloadDigest,
+  };
+}
+
+/** Public errors expose the acceptance outcome, not storage or hook identifiers. */
+export function inputAcceptanceErrorResponse(error: unknown): Response | undefined {
+  if (!WorkflowWorldError.is(error) || error.status === undefined) return undefined;
+  const messages: Record<number, [string, string]> = {
+    400: ["invalid_input_identity", "Invalid stable input identity."],
+    403: ["input_identity_unauthorized", "An authenticated principal is required."],
+    422: [
+      "input_conflict",
+      "This input identity conflicts with its accepted content or destination.",
+    ],
+    503: [
+      "input_acceptance_unavailable",
+      "Input acceptance is unavailable or pending; retry the same inputId.",
+    ],
+  };
+  const message = messages[error.status];
+  return message === undefined
+    ? undefined
+    : Response.json(
+        { ok: false, code: message[0], error: message[1] },
+        { status: error.status, headers: { "cache-control": "no-store" } },
+      );
+}
