+/**
+ * Republishes the wake for an input already durably accepted by this World.
+ * The receipt is always read from native storage; callers supply only its key.
+ * Missing receipts do not enqueue work. Terminal runs return their receipt
+ * without a wake. Queue failures remain errors even though acceptance survived.
+ */
+export async function recoverHookResume(input: {
+  readonly runId: string;
+  readonly inputId: string;
+  readonly scope?: string;
+}): Promise<HookResumeReceipt | undefined> {
+  if (!input.runId || !input.inputId || input.inputId.length > 256) {
+    throw new TypeError(
+      'Hook recovery requires runId and an inputId of 1–256 characters.'
+    );
+  }
+  const world = await getWorldLazy();
+  if (!world.events.getResume) {
+    throw new Error(
+      'This World does not support caller-stable hook acceptance.'
+    );
+  }
+  const receipt = await world.events.getResume(input.runId, input.inputId);
+  if (receipt === undefined) return undefined;
+  if (
+    receipt.runId !== input.runId ||
+    receipt.resumeId !== input.inputId ||
+    receipt.resumeScope !== input.scope
+  ) {
+    throw new WorkflowWorldError(
+      'Input receipt does not match its recovery scope.',
+      {
+        status: 422,
+      }
+    );
+  }
+  await wakeAcceptedHookResume(world, receipt);
+  return receipt;
+}
