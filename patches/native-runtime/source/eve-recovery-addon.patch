+/** Recover dispatch liveness for a stored receipt, without resending or reconstructing its input. */
+export async function recoverSessionInputReceipt(
+  input: SessionInputIdentity,
+): Promise<SessionInputReceipt | undefined> {
+  const receipt = await readSessionInputReceipt(input);
+  if (receipt === undefined) return undefined;
+  const scope = inputAcceptanceScope(input);
+  const recovered = await recoverHookResume({
+    runId: receipt.sessionId,
+    inputId: nativeInputKey(scope, input.inputId),
+    scope,
+  });
+  if (
+    recovered === undefined ||
+    recovered.runId !== receipt.sessionId ||
+    recovered.eventId !== receipt.eventId ||
+    recovered.payloadDigest !== receipt.payloadDigest
+  ) {
+    throw new WorkflowWorldError("Native input receipt changed during dispatch recovery.", {
+      status: 503,
+    });
+  }
+  return receipt;
+}
