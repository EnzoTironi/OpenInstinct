+import { WorkflowWorldError } from '@workflow/errors';
+import type { Pool, PoolClient } from 'pg';
+export type WorkerLeaseTiming = {
+    /** How long a lease remains valid without renewal (PostgreSQL clock). */
+    leaseMs: number;
+    /** How often a healthy worker renews its lease and Graphile lock timestamps. */
+    heartbeatMs: number;
+    /** How often the world scans for expired leases to reclaim. */
+    reclaimIntervalMs: number;
+};
+export declare const DEFAULT_WORKER_LEASE_TIMING: WorkerLeaseTiming;
+export type WorkerLeaseIdentity = {
+    readonly workerId: string;
+    readonly generation: number;
+};
+/** Headers bind an HTTP execution to a Graphile worker generation. */
+export declare const WORKER_LEASE_HEADERS: {
+    readonly workerId: "x-workflow-worker-id";
+    readonly generation: "x-workflow-worker-generation";
+    readonly jobId: "x-workflow-job-id";
+};
+export declare function getWorkerLeaseContext(): WorkerLeaseIdentity | undefined;
+export declare function runWithWorkerLease<T>(identity: WorkerLeaseIdentity, fn: () => T): T;
+export declare function resolveWorkerLeaseTiming(partial?: Partial<WorkerLeaseTiming>): WorkerLeaseTiming;
+type Queryable = Pick<Pool, 'query'> | Pick<PoolClient, 'query'>;
+export declare class WorkerLeaseFencedError extends WorkflowWorldError {
+    constructor(message?: string);
+}
+/**
+ * Register a new worker generation before Graphile can claim jobs.
+ * Retired worker IDs are never reused.
+ */
+export declare function registerWorkerLease(db: Queryable, workerId: string, leaseMs: number): Promise<WorkerLeaseIdentity>;
+/** Renew only while the exact generation is still active under the PG clock. */
+export declare function renewWorkerLease(db: Queryable, identity: WorkerLeaseIdentity, leaseMs: number): Promise<boolean>;
+/**
+ * Irrevocably retire expired generations, then release their Graphile locks.
+ * Expiry always happens before unlock so a SIGSTOP'd owner cannot complete.
+ */
+export declare function reclaimExpiredWorkerLeases(pool: Pool): Promise<string[]>;
+/** No-op when no lease context is bound (non-worker callers). */
+export declare function assertWorkerLeaseIfPresent(db: Queryable): Promise<void>;
+export declare function loadWorkerLease(db: Queryable, workerId: string, generation: number): Promise<WorkerLeaseIdentity | undefined>;
+/**
+ * Graphile Worker's completeJob deletes by job id only. Replace it with an
+ * owner-aware delete matching failJob, so a stale SIGSTOP'd owner cannot remove
+ * a job another worker holds.
+ */
