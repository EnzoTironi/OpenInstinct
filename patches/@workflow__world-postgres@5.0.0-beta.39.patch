+import { AsyncLocalStorage } from 'node:async_hooks';
+import { createRequire } from 'node:module';
+import { join } from 'node:path';
+import { WorkflowWorldError } from '@workflow/errors';
+export const DEFAULT_WORKER_LEASE_TIMING = {
+    leaseMs: 30_000,
+    heartbeatMs: 10_000,
+    reclaimIntervalMs: 5_000,
+};
+const leaseContext = new AsyncLocalStorage();
+/** Headers bind an HTTP execution to a Graphile worker generation. */
+export const WORKER_LEASE_HEADERS = {
+    workerId: 'x-workflow-worker-id',
+    generation: 'x-workflow-worker-generation',
+    jobId: 'x-workflow-job-id',
+};
+export function getWorkerLeaseContext() {
+    return leaseContext.getStore();
+}
+export function runWithWorkerLease(identity, fn) {
+    return leaseContext.run(identity, fn);
+}
+export function resolveWorkerLeaseTiming(partial) {
+    const timing = {
+        leaseMs: partial?.leaseMs ?? DEFAULT_WORKER_LEASE_TIMING.leaseMs,
+        heartbeatMs: partial?.heartbeatMs ?? DEFAULT_WORKER_LEASE_TIMING.heartbeatMs,
+        reclaimIntervalMs: partial?.reclaimIntervalMs ??
+            DEFAULT_WORKER_LEASE_TIMING.reclaimIntervalMs,
+    };
+    if (!(Number.isFinite(timing.leaseMs) &&
+        timing.leaseMs >= 1_000 &&
+        Number.isFinite(timing.heartbeatMs) &&
+        timing.heartbeatMs >= 100 &&
+        timing.heartbeatMs < timing.leaseMs &&
+        Number.isFinite(timing.reclaimIntervalMs) &&
+        timing.reclaimIntervalMs >= 100)) {
+        throw new TypeError('Worker lease timing requires leaseMs >= 1000, 100 <= heartbeatMs < leaseMs, and reclaimIntervalMs >= 100.');
+    }
+    return timing;
+}
+export class WorkerLeaseFencedError extends WorkflowWorldError {
+    constructor(message = 'Worker lease generation is no longer valid.') {
+        super(message, { status: 409 });
+        this.name = 'WorkerLeaseFencedError';
+    }
+}
+/**
+ * Register a new worker generation before Graphile can claim jobs.
+ * Retired worker IDs are never reused.
+ */
+export async function registerWorkerLease(db, workerId, leaseMs) {
+    const existing = await db.query(`SELECT generation::text, retired FROM workflow.worker_leases WHERE worker_id = $1`, [workerId]);
+    if (existing.rows[0]?.retired) {
+        throw new WorkerLeaseFencedError(`Worker identity ${workerId} was retired and cannot be reused.`);
+    }
+    if (existing.rows[0]) {
+        const renewed = await renewWorkerLease(db, { workerId, generation: Number(existing.rows[0].generation) }, leaseMs);
+        if (!renewed) {
+            throw new WorkerLeaseFencedError(`Worker identity ${workerId} could not renew its existing lease.`);
+        }
+        return { workerId, generation: Number(existing.rows[0].generation) };
+    }
+    const inserted = await db.query(`INSERT INTO workflow.worker_leases (worker_id, generation, lease_until, retired)
+     VALUES ($1, 1, now() + ($2::text || ' milliseconds')::interval, false)
+     RETURNING generation::text`, [workerId, String(leaseMs)]);
+    return { workerId, generation: Number(inserted.rows[0].generation) };
+}
+/** Renew only while the exact generation is still active under the PG clock. */
+export async function renewWorkerLease(db, identity, leaseMs) {
+    const result = await db.query(`UPDATE workflow.worker_leases
+     SET lease_until = now() + ($3::text || ' milliseconds')::interval,
+         updated_at = now()
+     WHERE worker_id = $1
+       AND generation = $2
+       AND NOT retired
+       AND lease_until >= now()
+     RETURNING generation`, [identity.workerId, identity.generation, String(leaseMs)]);
