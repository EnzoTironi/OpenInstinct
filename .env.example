# Optional overrides. Vercel deployments generate the two secrets in their
# connected private Blob store and derive the URL from Vercel system variables.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Public HTTPS origin for durable channel webhooks (no trailing slash).
# Prefer a named Cloudflare Tunnel hostname — not *.trycloudflare.com.
# Interim Enzo live base (2026-09-10): https://companion.tironi.xyz
# (zoen.space / app.zoen.space Companion cutover deferred; Fly product site stays).
COMPANION_PUBLIC_BASE_URL=
# The Neon Marketplace resource injects these automatically on Vercel. `pnpm
# dev` overrides both with the local Docker Compose database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:54329/open_instinct
# Eve workflow state and queues use Postgres. Defaults to DATABASE_URL.
# Run pnpm workflow:migrate before starting the runtime.
WORKFLOW_POSTGRES_URL=
# Internal Eve service origin for workflow callbacks (not the public Next URL).
WORKFLOW_LOCAL_BASE_URL=http://127.0.0.1:4274
WORKFLOW_POSTGRES_MAX_POOL_SIZE=10
WORKFLOW_POSTGRES_WORKER_CONCURRENCY=4
# Optional base64-encoded 32-byte override. Generate with: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# Optional for startup; required when browser execution is invoked.
# The Kernel Marketplace resource injects this automatically on Vercel.
# For manual setup, create a key at https://kernel.sh.
KERNEL_API_KEY=
# Required for the gateway profile outside Vercel. Vercel deployments use
# project OIDC for AI Gateway access instead.
AI_GATEWAY_API_KEY=
# gateway | codex-local | openrouter-free. codex-local uses the existing Codex
# login and gpt-5.3-codex-spark. Explicit profiles never silently fall back.
COMPANION_MODEL_PROVIDER=gateway
OPENROUTER_API_KEY=
# Telegram private chat, sign-in challenges and webhook verification.
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp through Kapso, sign-in challenges and webhook verification.
KAPSO_PHONE_NUMBER_ID=
KAPSO_PHONE_NUMBER=
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
# Vercel injects BLOB_STORE_ID and VERCEL_OIDC_TOKEN when a private Blob store
# is connected. Outside Vercel, set a read-write token instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Self-hosted Google OAuth. Register /api/auth/callback/google on this origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Vercel Connect configuration for Linq.
# Linq delivery requires the connector. The phone number only enables the
# optional click-to-message shortcut in the workspace.
LINQ_CONNECTOR=
LINQ_PHONE_NUMBER=
# Development benchmarks only (pnpm bench:browser).
BROWSER_BENCH_LABEL=self-hosted
BROWSER_BENCH_REPETITIONS=1

# Hosted consumer billing (optional). Free plan works without Stripe.
# Secret *names* only in docs — set values in Fly/Vercel secret stores.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ORG_SEAT=

# Operon MCP: a built CLI checkout and a persistent PostgreSQL URL (SQLite path locally).
# Zoen supplies the authenticated workspace and role to each private stdio process.
# Human reviews are verified through the host callback after Eve approval.
OPERON_HOME=
OPERON_DATABASE_URL=
OPERON_BUILDER_ENABLED=false
